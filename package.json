{
  "name": "piyasamatik",
  "productName": "Piyasamatik.com",
  "version": "0.8.0",
  "description": "Doviz, altin, ABD borsasi ve kripto para takip masaustu widget'i",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "start": "npm run build && electron .",
    "dev": "node build.js --watch",
    "pack": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --win --publish always",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.mustafacelik.piyasamatik",
    "productName": "Piyasamatik.com",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "mrcelix",
      "repo": "piyasamatik",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "electron-updater": "^6.8.9",
    "ws": "^8.21.1"
  }
}
